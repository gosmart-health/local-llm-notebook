# ==============================================================================
# llama-server Configuration
# ==============================================================================

# Base URL for llama.cpp server (local or network IP)
# Examples:
#   Localhost: http://localhost:11434
#   LAN IP:    http://10.200.0.103:11434
LLAMA_SERVER_HOST=http://localhost:11434

# OpenAI-compatible API endpoint (standard llama-server routes under /v1)
LLAMA_API_BASE=http://localhost:11434/v1

# API Key (optional for local llama-server unless --api-key flag was used)
LLAMA_API_KEY=no-key-required

# Default model identifiers
DEFAULT_CHAT_MODEL=local-model
DEFAULT_EMBEDDING_MODEL=local-embedding

# Timeout for requests in seconds
LLAMA_REQUEST_TIMEOUT=120
